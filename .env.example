# ─────────────────────────────────────────────────────────────────
# VC Scout Intelligence — Environment Variables
# Copy this file to Backend/.env and fill in your values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────

# ── Server ──────────────────────────────────────────────────────
PORT=5000

# ── Database ────────────────────────────────────────────────────
# MongoDB Atlas connection string
# Format: mongodb+srv://<user>:<password>@cluster.mongodb.net/<dbname>?retryWrites=true&w=majority
MONGO_URI=

# ── AI / Enrichment APIs ─────────────────────────────────────────
# Google Gemini — used for AI-powered company insight extraction
# Get your key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Firecrawl — used for website scraping (enrichment step 1)
# Get your key at: https://www.firecrawl.dev/
FIRECRAWL_KEY=

# OpenAI — reserved for future features (not currently used)
OPENAI_KEY=

# ── App ─────────────────────────────────────────────────────────
# Set to "production" in prod environments to suppress debug logs and stack traces
NODE_ENV=development
